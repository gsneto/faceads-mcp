{
  "name": "fb-marketing-mcp",
  "version": "1.0.0",
  "description": "MCP Server para Facebook Marketing API - Documentação e Execução",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "fb-marketing-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "docs",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js --http --port 3000",
    "dev": "tsc --watch",
    "scrape": "node scripts/scrape-docs.js",
    "scrape:resume": "node scripts/scrape-docs.js --resume",
    "retry-errors": "node scripts/retry-errors.js",
    "discover": "node scripts/discover-urls.js",
    "extract-links": "node scripts/extract-links.js",
    "test:security": "node --test tests/security.test.mjs",
    "desktop:start": "npm run build && electron desktop/main.cjs",
    "desktop:dist": "npm run build && electron-builder --win nsis"
  },
  "keywords": [
    "mcp",
    "facebook",
    "meta",
    "marketing-api",
    "ads",
    "documentation"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "pg": "^8.18.0",
    "prisma": "7.10.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.16.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "puppeteer": "^24.0.0",
    "turndown": "^7.2.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=24"
  },
  "build": {
    "appId": "com.gsneto.pratinhopronto.metaads",
    "productName": "Meta Ads Pratinho Pronto",
    "artifactName": "Meta-Ads-Pratinho-Pronto-Setup-${version}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "dist/**/*",
      "docs/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "desktop/main.cjs"
    },
    "win": {
      "icon": "desktop/assets/icon.ico",
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "allowScripts": {
    "electron@44.3.0": true
  }
}
