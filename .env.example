# ── Required ──────────────────────────────────────────────────────────────────

# Postgres connection string. On Railway, set this to: ${{Postgres.DATABASE_URL}}
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# Public base URL where this MCP server is reachable (used for OAuth callbacks).
# On Railway, after the service has a public domain, set to: https://${{RAILWAY_PUBLIC_DOMAIN}}
MCP_BASE_URL="https://your-domain.example.com"

# 64-char hex (32 bytes) used to encrypt Meta tokens at rest.
# Local: generate with `openssl rand -hex 32`.
# Railway: paste literally `${{ secret(64, "0123456789abcdef") }}` — Railway
# generates a unique value on first deploy and stores it as a secret.
MCP_ENCRYPTION_KEY="replace-with-64-char-hex"

# ── Optional ──────────────────────────────────────────────────────────────────

# Fallback Meta access token for single-tenant mode (multi-tenant uses OAuth instead).
# META_ACCESS_TOKEN=""

# Meta Marketing API version (default: v24.0)
# META_API_VERSION="v24.0"

# HTTP port (Railway injects PORT automatically)
# PORT=3000
